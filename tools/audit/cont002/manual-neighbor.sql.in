begin;
set local search_path to __SCHEMA__,public;
do $guard$ begin if obj_description('__SCHEMA__'::regnamespace,'pg_namespace') is distinct from '__MARKER__' then raise exception 'TASK_SCHEMA_OWNER_CHANGED'; end if; end $guard$;
do $seed$ declare v_resource_id bigint; v_type_id bigint; v_recipe_id bigint; v_template_id bigint; label text; canonical_type text; result jsonb := '[]'; begin
insert into catalog_entities(identity_key,public_id,entity_type,status) values('__RESOURCE_IDENTITY__',new_public_id(),'resource','active') returning id into v_resource_id;
insert into game_resources(entity_id,kind_code,canonical_id,namespace,resource_path) values(v_resource_id,'minecraft.item','__NAMESPACE__:manual_result','__NAMESPACE__','manual_result');
foreach label in array array['manual_only','mixed'] loop
if label='manual_only' then
insert into catalog_entities(identity_key,public_id,entity_type,status) values('__TYPE_IDENTITY__',new_public_id(),'recipe_type','active') returning id into v_type_id;
canonical_type:='__NAMESPACE__:manual_only';
insert into recipe_types(entity_id,canonical_id) values(v_type_id,canonical_type);
else canonical_type:='__MIXED_TYPE__'; select entity_id into strict v_type_id from recipe_types where canonical_id=canonical_type; if not exists(select 1 from recipes r join recipe_import_snapshots s on s.recipe_id=r.entity_id where r.recipe_type_id=v_type_id) then raise exception 'MIXED_REQUIRES_EXISTING_IMPORTED_RECIPE'; end if; end if;
insert into catalog_entities(identity_key,public_id,entity_type,status) values('__NAMESPACE__:recipe:'||label,new_public_id(),'recipe','active') returning id into v_recipe_id;
insert into recipes(entity_id,recipe_type_id,canonical_source_id,semantic_fingerprint,identity_source) values(v_recipe_id,v_type_id,'__NAMESPACE__:'||label,'__NAMESPACE__-fingerprint-'||label,'manual');
insert into catalog_entities(identity_key,public_id,entity_type,status) values('__NAMESPACE__:template:'||label,new_public_id(),'recipe_template','active') returning id into v_template_id;
insert into recipe_layout_templates(entity_id,recipe_type_id,template_key,canvas_width,canvas_height,image_scale) values(v_template_id,v_type_id,'__NAMESPACE__-layout-'||label,100,50,1);
insert into recipe_template_slots(identity_key,template_id,slot_key,role,ordinal,x,y,width,height) values('__NAMESPACE__:'||label||':empty',v_template_id,'empty','input',0,1,1,16,16),('__NAMESPACE__:'||label||':output',v_template_id,'output','output',1,30,1,16,16);
insert into recipe_definitions(recipe_id,template_id,definition) values(v_recipe_id,v_template_id,'{"layout_kind":"not_applicable"}');
insert into recipe_bindings(identity_key,recipe_id,template_slot_id,ordinal) select '__NAMESPACE__:'||label||':binding',v_recipe_id,id,1 from recipe_template_slots where recipe_template_slots.template_id=v_template_id and slot_key='output' order by id desc limit 1;
insert into recipe_binding_candidates(identity_key,binding_id,candidate_index,resource_id,amount,probability) select '__NAMESPACE__:'||label||':candidate',id,0,v_resource_id,3,.5 from recipe_bindings where recipe_bindings.recipe_id=v_recipe_id;
end loop;
end $seed$;
update catalog_dataset_state set version=version+1 where singleton;
select jsonb_agg(jsonb_build_object('recipePublicId',e.public_id,'recipeCanonicalId',r.canonical_source_id,'typePublicId',t.public_id,'typeCanonicalId',rt.canonical_id)) from recipes r join catalog_entities e on e.id=r.entity_id join recipe_types rt on rt.entity_id=r.recipe_type_id join catalog_entities t on t.id=rt.entity_id where r.canonical_source_id like '__NAMESPACE__:%';
commit;
