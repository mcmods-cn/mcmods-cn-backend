APP_ADDR=:8080
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mcmods
DB_USER=mcmods
DB_PASSWORD=
DB_SSLMODE=disable
# Development only. Drops and recreates the public schema once at startup.
DB_RESET_ON_START=false

JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL_HOURS=24
SEED_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mcmods.cn
SMTP_USE_TLS=true

# Shared query cache. When unavailable, the API falls back to a bounded
# in-process cache so public catalog pages remain usable.
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=mcmods:query:
REDIS_QUERY_TTL_SECONDS=120

# Optional initial credentials for automatic mod metadata imports.
# They can also be managed in Admin > Mod import sources.
MODRINTH_TOKEN=
CURSEFORGE_API_KEY=
GITHUB_TOKEN=
