APP_ADDR=:8080
APP_ENV=development
APP_REPLICA_COUNT=1
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated reverse-proxy IPs/CIDRs allowed to supply client IP and
# location headers. Leave empty when the API is reached directly.
TRUSTED_PROXY_CIDRS=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mcmods
DB_USER=mcmods
DB_PASSWORD=
DB_SSLMODE=disable
# Development only. Drops and recreates the public schema once at startup.
DB_RESET_ON_START=false
# Required when reset is enabled. It must exactly match "RESET <effective DB
# name>"; for the default local database use: RESET mcmods
DB_RESET_CONFIRM=
# User-facing request pool. Size this together with PostgreSQL max_connections.
DB_MAX_CONNS=12
DB_MIN_CONNS=2

# Player activity ingestion. Views use a bounded best-effort queue; all other
# actions first enter a durable PostgreSQL outbox. The activity pool has a
# separate connection budget so ingestion cannot exhaust the API pool.
ACTIVITY_BATCH_SIZE=256
ACTIVITY_QUEUE_CAPACITY=4096
ACTIVITY_FLUSH_INTERVAL_MS=1000
ACTIVITY_RETRY_MIN_MS=250
ACTIVITY_RETRY_MAX_MS=30000
ACTIVITY_WRITE_TIMEOUT_MS=10000
ACTIVITY_DURABLE_ENQUEUE_TIMEOUT_MS=1500
ACTIVITY_DB_MAX_CONNS=4
ACTIVITY_DB_MIN_CONNS=1

JWT_SECRET=change-this-to-a-long-random-string
# Separate random key used to encrypt provider credentials stored in PostgreSQL.
SETTINGS_ENCRYPTION_KEY=change-this-to-a-different-long-random-string
JWT_TTL_HOURS=24
SEED_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mcmods.cn
SMTP_USE_TLS=true

# Shared ephemeral state and derived cache. Production multi-replica deployments
# should set REDIS_ENABLED=true and REDIS_REQUIRED=true. Each environment must
# use a distinct namespace.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=mcmods
REDIS_NAMESPACE=development
REDIS_QUERY_TTL_SECONDS=120
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT_MS=1000
REDIS_READ_TIMEOUT_MS=750
REDIS_WRITE_TIMEOUT_MS=750
REDIS_AUTH_SESSION_CACHE_ENABLED=true
REDIS_RBAC_CACHE_ENABLED=true
REDIS_AUTH_RATE_LIMIT_ENABLED=true
REDIS_PRESENCE_ENABLED=true
REDIS_UNREAD_COUNTER_ENABLED=true
REDIS_SETTINGS_CACHE_ENABLED=true
REDIS_USER_CARD_CACHE_ENABLED=true
REDIS_AUTH_SESSION_TTL_SECONDS=60
REDIS_RBAC_TTL_SECONDS=120
REDIS_PRESENCE_TTL_SECONDS=150
PRESENCE_SNAPSHOT_INTERVAL_SECONDS=600
REDIS_UNREAD_TTL_SECONDS=300
REDIS_UNREAD_RECONCILE_MINUTES=30
REDIS_UNREAD_RECONCILE_BATCH_SIZE=50
REDIS_USER_CARD_TTL_SECONDS=45

# Core NATS remains available for ephemeral realtime fan-out. Reliable tasks are
# recorded in PostgreSQL Outbox first. Enable JetStream only on a server with
# JetStream storage configured.
NATS_ENABLED=true
NATS_URL=nats://127.0.0.1:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_TOKEN=
NATS_SUBJECT_PREFIX=mcmods
NATS_OUTBOX_ENABLED=true
NATS_JETSTREAM_ENABLED=false
NATS_JETSTREAM_STREAM=MCMODS_TASKS
NATS_JETSTREAM_MAX_DELIVER=8
NATS_JETSTREAM_ACK_WAIT_SECONDS=300
NATS_JETSTREAM_PUBLISH_TIMEOUT_SECONDS=5
REALTIME_ENABLED=true

# Shared anti-abuse state uses Redis when enabled and a bounded in-process
# fallback in single-replica development. Generate independent 32+ character
# secrets outside development; never reuse public API tokens here.
ANTI_ABUSE_ENABLED=true
ANTI_ABUSE_HMAC_SECRET=development-only-change-this-anti-abuse-hmac-secret
ANTI_ABUSE_IP_HASH_SECRET=development-only-change-this-anti-abuse-ip-hash-secret
ANTI_ABUSE_CHALLENGE_PROVIDER=proof
ANTI_ABUSE_FORM_TOKEN_TTL_MINUTES=30
ANTI_ABUSE_FORM_MINIMUM_AGE_MS=800
ANTI_ABUSE_CHALLENGE_TTL_MINUTES=10
ANTI_ABUSE_EVENT_RETENTION_DAYS=180
ANTI_ABUSE_FINGERPRINT_RETENTION_DAYS=30
ANTI_ABUSE_DNS_TIMEOUT_MS=750
ANTI_ABUSE_DNS_CACHE_HOURS=6
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Optional typo-tolerant search service. PostgreSQL remains authoritative and
# automatically serves requests whenever Typesense is disabled or unavailable.
TYPESENSE_ENABLED=false
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION_PREFIX=mcmods
TYPESENSE_TIMEOUT_SECONDS=3

# Optional initial credentials for automatic mod metadata imports.
# They can also be managed in Admin > Mod import sources.
MODRINTH_TOKEN=
CURSEFORGE_API_KEY=
GITHUB_TOKEN=

# Third-party Minecraft launcher authentication (authlib-injector/Yggdrasil).
YGGDRASIL_ENABLED=true
# PRIVATE_KEY_BASE64 must contain a base64-encoded PEM RSA private key in production.
YGGDRASIL_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/yggdrasil/
YGGDRASIL_TEXTURE_BASE_URL=http://127.0.0.1:8080/api/yggdrasil/textures/
YGGDRASIL_SERVER_NAME=Mcmods-cn
YGGDRASIL_PRIVATE_KEY_BASE64=
# Comma-separated reverse-proxy IPs/CIDRs allowed to supply client IP headers.
# Every trusted edge must overwrite provider client-IP headers and append a clean X-Forwarded-For hop.
YGGDRASIL_TRUSTED_PROXY_CIDRS=
YGGDRASIL_TOKEN_TTL_HOURS=360
YGGDRASIL_MAX_TOKENS=10
YGGDRASIL_JOIN_TTL_SECONDS=30
YGGDRASIL_TEXTURE_MAX_BYTES=2097152
